{
  "name": "scrutineering",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validate:policy-contract": "node scripts/validate-policy-contract.mjs",
    "validate:evidence-contract": "node scripts/validate-evidence-contract.mjs",
    "report:debrief-compliance": "node scripts/generate-debrief-compliance-report.mjs",
    "artifact:staging-pr": "node scripts/generate-staging-pr-artifact.mjs",
    "verify:remediation-prs": "node scripts/run-verification-harness.mjs",
    "harness:remediation-dry-run": "node scripts/run-remediation-dry-run-harness.mjs",
    "test": "node --test",
    "verify:local": "node scripts/verify-local-ci.mjs",
    "start:planner": "node src/planner/server.mjs",
    "report:security-outcomes": "node scripts/generate-security-outcome-report.mjs",
    "drill:staging-rollback": "node scripts/run-staging-rollback-drill.mjs",
    "drill:staging-evidence": "PYTHONPATH=. uv run --with-requirements requirements.txt python scripts/run-staging-evidence-gate.py",
    "drill:staging-readiness": "PYTHONPATH=. uv run --with-requirements requirements.txt python scripts/run-staging-readiness.py",
    "validate:deployment": "node scripts/validate-deployment-config.mjs",
    "validate:docs": "node scripts/validate-doc-links.mjs",
    "validate:frontend": "node scripts/validate-frontend-config.mjs",
    "validate:release": "node scripts/validate-release-config.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
