# --- Python Celery Worker ---
FROM python:3.13-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install system deps needed for psycopg2 and scanner binaries
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      libpq-dev gcc curl jq git nodejs npm docker-cli kubectl && \
    rm -rf /var/lib/apt/lists/*

# Install a pinned Trivy release (avoid executing a moving install script).
ARG TRIVY_VERSION=0.76.2
RUN curl -sSfL "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz" \
    | tar -xz -C /usr/local/bin trivy

# Install a pinned Grype release (avoid executing a moving install script).
ARG GRYPE_VERSION=0.121.2
RUN curl -sSfL "https://github.com/anchore/grype/releases/download/v${GRYPE_VERSION}/grype_${GRYPE_VERSION}_linux_amd64.tar.gz" \
    | tar -xz -C /usr/local/bin grype

# buildctl talks to the rootless buildkitd service to build remediation candidates.
COPY --from=moby/buildkit:v0.34.2-rootless /usr/bin/buildctl /usr/local/bin/buildctl

# Install Python deps
COPY requirements.txt ./
# pip is build-time only; the runtime never invokes it. Removing it (and the
# ensurepip bootstrap copy) also removes pip's vendored libraries, which an
# image scan otherwise reports as this image's own vulnerable packages.
RUN pip install --no-cache-dir -r requirements.txt \
    && pip uninstall -y pip \
    && rm -rf /usr/local/lib/python3.13/ensurepip

# Copy source
COPY src/ ./src/

# Keep runtime state writable only in /tmp and run the worker as an unprivileged user.
RUN addgroup --system scanner && adduser --system --ingroup scanner scanner && \
    mkdir -p /tmp/scanner-cache /tmp/grype /var/lib/scrutineering/signing && \
    chown -R scanner:scanner /app /tmp/scanner-cache /tmp/grype /var/lib/scrutineering && \
    chmod 700 /var/lib/scrutineering/signing
USER scanner

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import src.scan.tasks" || exit 1

# Celery needs to run from the project root so "src.scan" is importable
ENV PYTHONPATH=/app
ENV PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp \
    GRYPE_DB_CACHE_DIR=/tmp/grype
ENV CELERY_BROKER_URL=redis://redis:6379/0

# Default command runs the Celery worker
CMD celery --app=src.scan.tasks:app worker \
  --loglevel=${CELERY_LOG_LEVEL:-info} \
  --concurrency=${CELERY_CONCURRENCY:-2} \
  --queues=${CELERY_QUEUES:-scan.low,scan.normal,scan.high,remediation.normal,notify}
