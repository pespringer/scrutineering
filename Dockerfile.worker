# --- Python Celery Worker ---
FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install system deps needed for psycopg2 and scanner binaries
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      libpq-dev gcc curl jq git nodejs npm && \
    rm -rf /var/lib/apt/lists/*

# Install a pinned Trivy release (avoid executing a moving install script).
ARG TRIVY_VERSION=0.76.2
RUN curl -sSfL "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz" \
    | tar -xz -C /usr/local/bin trivy

# Install a pinned Grype release (avoid executing a moving install script).
ARG GRYPE_VERSION=0.121.0
RUN curl -sSfL "https://github.com/anchore/grype/releases/download/v${GRYPE_VERSION}/grype_${GRYPE_VERSION}_linux_amd64.tar.gz" \
    | tar -xz -C /usr/local/bin grype

# Install a pinned Cosign release for signed release-evidence verification.
ARG COSIGN_VERSION=3.1.4
RUN curl -sSfL "https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}/cosign-linux-amd64" \
    -o /usr/local/bin/cosign && chmod 0755 /usr/local/bin/cosign

# Install a pinned Syft release for the SBOM validation gate.
ARG SYFT_VERSION=1.57.1
ARG SYFT_SHA256=bf52519eb57f675d47c07d43213cb6dff6449f3d6d1147ff6701ed91f44eef0c
RUN curl -sSfL "https://github.com/anchore/syft/releases/download/v${SYFT_VERSION}/syft_${SYFT_VERSION}_linux_amd64.tar.gz" \
    -o /tmp/syft.tar.gz && \
    echo "${SYFT_SHA256}  /tmp/syft.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/syft.tar.gz -C /usr/local/bin syft && \
    rm -f /tmp/syft.tar.gz

# Install Python deps
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy source
COPY src/ ./src/

# Keep runtime state writable only in /tmp and run the worker as an unprivileged user.
RUN addgroup --system scanner && adduser --system --ingroup scanner scanner && \
    mkdir -p /tmp/scanner-cache /tmp/grype && chown -R scanner:scanner /app /tmp/scanner-cache /tmp/grype
USER scanner

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import src.scan.tasks" || exit 1

# Celery needs to run from the project root so "src.scan" is importable
ENV PYTHONPATH=/app
ENV PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp \
    GRYPE_DB_CACHE_DIR=/tmp/grype
ENV CELERY_BROKER_URL=redis://redis:6379/0

# Default command runs the Celery worker
CMD celery --app=src.scan.tasks:app worker \
  --loglevel=${CELERY_LOG_LEVEL:-info} \
  --concurrency=${CELERY_CONCURRENCY:-2} \
  --queues=${CELERY_QUEUES:-scan,remediation.normal}
