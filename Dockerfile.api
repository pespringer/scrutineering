# --- Python FastAPI dashboard/data API ---
FROM python:3.13-slim
WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends libpq-dev gcc curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
# pip is build-time only; the runtime never invokes it. Removing it (and the
# ensurepip bootstrap copy) also removes pip's vendored libraries, which the
# image scan otherwise reports as this image's own vulnerable packages.
RUN pip install --no-cache-dir -r requirements.txt \
    && pip uninstall -y pip \
    && rm -rf /usr/local/lib/python3.13/ensurepip

COPY src/ ./src/

RUN addgroup --system api \
    && adduser --system --ingroup api api \
    && chown -R api:api /app
USER api

EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=5 \
  CMD curl -fsS http://127.0.0.1:8000/health || exit 1

CMD ["uvicorn", "src.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
