# ============================================================================
# Container Sentinel — Environment Variables
#
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=scrutineering
POSTGRES_PASSWORD=
POSTGRES_DB=scrutineering
# Optional host port exposure; use docker-compose.host-access.yml explicitly.
POSTGRES_PORT=5432
# Full SQLAlchemy-compatible connection string (used by app + workers)
DATABASE_URL=
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ---------------------------------------------------------------------------
# Redis (Celery broker + result backend)
# ---------------------------------------------------------------------------
# Optional host port exposure; use docker-compose.host-access.yml explicitly.
REDIS_PORT=6379
# URL used by the Node.js app (general-purpose access)
REDIS_URL=redis://redis:6379/0
# Celery-specific endpoints
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------------------------------------------------------------------------
# Node.js Planner Server
# ---------------------------------------------------------------------------
PLANNER_HOST=0.0.0.0
PLANNER_PORT=3000
# Required when PLANNER_HOST is non-loopback. Generate a strong random value.
PLANNER_API_KEY=
# Single-instance request ceiling; use a shared limiter for multi-replica deployments.
PLANNER_RATE_LIMIT_PER_MINUTE=60
PLANNER_API_KEYS_JSON=

# OIDC provider used by the planner's configured authentication boundary.
OIDC_ISSUER=
OIDC_AUDIENCE=

# ---------------------------------------------------------------------------
# Celery Worker / Beat
# ---------------------------------------------------------------------------
CELERY_LOG_LEVEL=info
CELERY_CONCURRENCY=2
CELERY_QUEUES=scan.low,scan.normal,scan.high

# ---------------------------------------------------------------------------
# Scanner Configuration
# ---------------------------------------------------------------------------
# Trivy severity filter (comma-separated)
TRIVY_SEVERITY=CRITICAL,HIGH
# Grype minimum severity threshold (Unknown, Negligible, Low, Medium, High, Critical)
GRYPE_SEVERITY_THRESHOLD=High
# Maximum seconds a single scan task may run
SCANNER_TIMEOUT=1800
# Directory for scanner caches inside the worker container
SCANNER_CACHE_DIR=/tmp/scanner-cache
SCANNER_MAX_OUTPUT_BYTES=50000000
SCANNER_MAX_FINDINGS=100000

# ---------------------------------------------------------------------------
# Publication and evidence policy
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_ALLOWED_REPOSITORIES=
GITLAB_TOKEN=
GITLAB_ALLOWED_PROJECTS=
DOCKERHUB_USERNAME=
DOCKERHUB_PASSWORD=
GITLAB_USERNAME=gitlab-ci-token
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
COSIGN_OIDC_ISSUER=https://token.actions.githubusercontent.com
COSIGN_CERTIFICATE_IDENTITY=
OIDC_LEEWAY_SECONDS=60
SCRUTINEERING_VERSION=0.1.0
SCRUTINEERING_REVISION=
SERVICE_AUTH_MAX_SKEW_SECONDS=300
SERVICE_AUTH_SECRET=
SERVICE_AUTH_REQUIRED=false
EVIDENCE_MAX_AGE_SECONDS=86400
EVIDENCE_MAX_ARTIFACT_BYTES=50000000
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=scrutineering

# ---------------------------------------------------------------------------
# Celery Beat Scheduler
# ---------------------------------------------------------------------------
# Cron expression for periodic scans (default: every 6 hours)
SCHEDULE_CRON_SCAN=0 */6 * * *
