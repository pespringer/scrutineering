# Scrutineering settings. Copy to .env:  cp .env.example .env
# Every variable is described in docs/CONFIGURATION.md (generated from src/config.py).
# An empty value means the default.

# -- Database -----------------------------------------------------------------
POSTGRES_USER=scrutineering
# Required: choose a password, and use it in DATABASE_URL too.
POSTGRES_PASSWORD=
POSTGRES_DB=scrutineering
# Required, e.g. postgresql+psycopg2://scrutineering:<password>@postgres:5432/scrutineering
DATABASE_URL=
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# -- Queue --------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_URL=redis://redis:6379/0
CELERY_QUEUES=scan.low,scan.normal,scan.high,remediation.normal,notify
CELERY_CONCURRENCY=2
CELERY_LOG_LEVEL=info

# -- API and dashboard --------------------------------------------------------
# Required: a long random value (for example `openssl rand -hex 32`).
PYTHON_API_KEY=
PYTHON_API_PORT=8000
DASHBOARD_PORT=3001
DASHBOARD_AUTH_MODE=local
DASHBOARD_DEFAULT_ROLES=dashboard,operator,remediator,security-operator
DASHBOARD_TRUSTED_PROXY_SECRET=
# trusted-proxy only: identity-provider groups to roles, e.g. ops=operator,security=security-operator
DASHBOARD_GROUP_ROLES=
SERVICE_AUTH_SECRET=
SERVICE_AUTH_REQUIRED=false

# -- Local registry -----------------------------------------------------------
# Push from the host to localhost:5000; the services reach it as registry:5000.
LOCAL_REGISTRY_PORT=5000
LOCAL_REGISTRY_HOST=registry:5000
LOCAL_REGISTRY_PUBLIC_HOST=localhost:5000
# The bundled registry speaks HTTP. This allows HTTP for it (and localhost) only.
REGISTRY_INSECURE=true

# -- Scanning -----------------------------------------------------------------
SCANNER_TIMEOUT=1800
SCANNER_RETRY_ATTEMPTS=2
SCANNER_RETRY_BACKOFF_SECONDS=5
SCANNER_CACHE_DIR=/tmp/scanner-cache
SCANNER_CACHE_BACKEND=local
GRYPE_DB_CACHE_DIR=/tmp/grype
REQUIRE_IMMUTABLE_SCAN_IDENTITY=false
SCHEDULE_CRON_SCAN=0 */6 * * *
SCAN_COOLDOWN_SECONDS=3600

# -- Runtime discovery (needs docker-compose.deployment-docker.yml) -----------
SCAN_RUNTIME_DISCOVERY_ENABLED=true
SCAN_RUNTIME_INCLUDE_IMAGES=
SCAN_RUNTIME_EXCLUDE_IMAGES=
SCAN_RUNTIME_MAX_IMAGES=100

# -- Registry credentials for private images ----------------------------------
# GITHUB_TOKEN (below) also covers ghcr.io. ECR and GCR use the standard AWS and
# Google credentials, which the scanners read themselves.
DOCKERHUB_USERNAME=
DOCKERHUB_PASSWORD=
GITLAB_TOKEN=
# Any other registry: {"harbor.example": {"username": "bot", "password": "..."}}
REGISTRY_CREDENTIALS_JSON=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# -- Remediation and GitHub ---------------------------------------------------
# Build and verify approved remediations on the buildkitd service.
REMEDIATION_EXECUTION_ENABLED=false
# Host folder holding local source repositories (mounted read-only into the worker).
REMEDIATION_HOST_SOURCES=./.local/remediation-sources
# Opens pull requests and clones github.com sources: Contents and Pull requests
# read/write on the source repositories.
GITHUB_TOKEN=
# Secret of the repository's pull_request webhook.
GITHUB_WEBHOOK_SECRET=
