# ============================================================================
# Container Sentinel — Environment Variables
#
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=scrutineering
POSTGRES_PASSWORD=
POSTGRES_DB=scrutineering
# Optional host port exposure; use docker-compose.host-access.yml explicitly.
POSTGRES_PORT=5432
# Full SQLAlchemy-compatible connection string (used by app + workers)
DATABASE_URL=
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ---------------------------------------------------------------------------
# Redis (Celery broker + result backend)
# ---------------------------------------------------------------------------
# Optional host port exposure; use docker-compose.host-access.yml explicitly.
REDIS_PORT=6379
# URL used by the Node.js app (general-purpose access)
REDIS_URL=redis://redis:6379/0
# Celery-specific endpoints
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------------------------------------------------------------------------
# Node.js Planner Server
# ---------------------------------------------------------------------------
PLANNER_HOST=0.0.0.0
PLANNER_PORT=3000
# Host port for the Compose Next.js dashboard
DASHBOARD_PORT=3001
# Browser-visible API URL. Leave empty: dashboard routes proxy server-side.
NEXT_PUBLIC_API_URL=

# Authenticated Python dashboard/data API
PYTHON_API_PORT=8000
# If blank, Compose reuses PLANNER_API_KEY for local development.
PYTHON_API_KEY=
# Server-only dashboard proxy settings. The API key is never sent to browsers.
DASHBOARD_API_URL=
DASHBOARD_API_KEY=
# Optional trusted ingress secret for forwarding verified OIDC identity headers.
DASHBOARD_TRUSTED_PROXY_SECRET=
# Comma-separated roles for local API-key dashboard sessions.
DASHBOARD_DEFAULT_ROLES=dashboard,operator
# Required before issuing or accepting remediation approval tokens.
REMEDIATION_APPROVAL_SECRET=
# Keep false until a reviewed execution adapter and repository root are deployed.
REMEDIATION_EXECUTION_ENABLED=false
REMEDIATION_PUSH_ENABLED=false
REMEDIATION_BRANCH_PREFIX=scrutineering/remediation
REMEDIATION_GIT_REMOTE=origin
REMEDIATION_HOST_REPOSITORY_ROOT=./.local/remediation-repo
REMEDIATION_HOST_EVIDENCE_ROOT=./.local/remediation-evidence
REMEDIATION_REPOSITORY_ROOT=/workspace/repository
REMEDIATION_EVIDENCE_FILE=/workspace/evidence/envelope.json
REMEDIATION_EVIDENCE_ARTIFACT_FILE=/workspace/evidence/artifact.json
REMEDIATION_VALIDATION_PROVIDER=
REMEDIATION_VALIDATION_ECOSYSTEM=
REMEDIATION_ALLOWED_REPOSITORIES=
REMEDIATION_PUBLICATION_ENABLED=false
REMEDIATION_PUBLICATION_PROVIDER=github
REMEDIATION_PUBLICATION_REPOSITORY=
REMEDIATION_PUBLICATION_BASE=main
# Reconciliation age threshold for pending, failed, or unverified merged publications.
REMEDIATION_PUBLICATION_STALE_SECONDS=900
REMEDIATION_PUBLICATION_ESCALATION_CYCLES=3
REMEDIATION_EVIDENCE_RETENTION_DAYS=365
REMEDIATION_EVIDENCE_PURGE_ENABLED=false
REMEDIATION_ALERT_MAX_ATTEMPTS=5
REMEDIATION_ALERT_DELIVERY_ENABLED=false
REMEDIATION_MAX_CHANGED_FILES=50
REMEDIATION_COMMAND_OUTPUT_BYTES=2000
REMEDIATION_EXECUTION_MEMORY_MB=1024
REMEDIATION_EXECUTION_CPU_SECONDS=600
REMEDIATION_ARTIFACT_QUARANTINE_DAYS=30
BACKUP_RETENTION_COUNT=7
BACKUP_MAX_AGE_DAYS=30
EVIDENCE_EXPORT_SIGNING_SECRET=
PROVIDER_TOKEN_MAX_AGE_DAYS=90
PROVIDER_STATUS_CACHE_SECONDS=0
GITHUB_TOKEN=
GITLAB_TOKEN=
# Optional comma-separated scope metadata used by provider credential diagnostics.
GITHUB_TOKEN_REQUIRED_SCOPES=
GITLAB_TOKEN_REQUIRED_SCOPES=
GITHUB_GRANTED_PERMISSIONS=
GITLAB_GRANTED_PERMISSIONS=
COSIGN_CERTIFICATE_IDENTITY=
COSIGN_OIDC_ISSUER=https://token.actions.githubusercontent.com
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=
# Required when PLANNER_HOST is non-loopback. Generate a strong random value.
PLANNER_API_KEY=
# Single-instance request ceiling; use a shared limiter for multi-replica deployments.
PLANNER_RATE_LIMIT_PER_MINUTE=60
PLANNER_API_KEYS_JSON=

# OIDC provider used by the planner's configured authentication boundary.
OIDC_ISSUER=
OIDC_AUDIENCE=

# ---------------------------------------------------------------------------
# Celery Worker / Beat
# ---------------------------------------------------------------------------
CELERY_LOG_LEVEL=info
CELERY_CONCURRENCY=2
CELERY_QUEUES=scan.low,scan.normal,scan.high,remediation.normal

# ---------------------------------------------------------------------------
# Scanner Configuration
# ---------------------------------------------------------------------------
# Trivy severity filter (comma-separated)
TRIVY_SEVERITY=CRITICAL,HIGH
# Grype minimum severity threshold (Unknown, Negligible, Low, Medium, High, Critical)
GRYPE_SEVERITY_THRESHOLD=High
# Maximum seconds a single scan task may run
SCANNER_TIMEOUT=1800
# Directory for scanner caches inside the worker container
SCANNER_CACHE_DIR=/tmp/scanner-cache
SCANNER_CACHE_BACKEND=local
SCANNER_CACHE_TTL_SECONDS=3600
GRYPE_DB_CACHE_DIR=/tmp/grype
SCANNER_MAX_OUTPUT_BYTES=50000000
SCANNER_MAX_FINDINGS=100000

# ---------------------------------------------------------------------------
# Publication and evidence policy
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_ALLOWED_REPOSITORIES=
GITLAB_TOKEN=
GITLAB_ALLOWED_PROJECTS=
GITHUB_TOKEN_REQUIRED_SCOPES=
GITLAB_TOKEN_REQUIRED_SCOPES=
REQUIRE_BRANCH_PROTECTION=true
DOCKERHUB_USERNAME=
DOCKERHUB_PASSWORD=
GITLAB_USERNAME=gitlab-ci-token
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
COSIGN_OIDC_ISSUER=https://token.actions.githubusercontent.com
COSIGN_CERTIFICATE_IDENTITY=
OIDC_LEEWAY_SECONDS=60
SCRUTINEERING_VERSION=0.1.0
SCRUTINEERING_REVISION=
SERVICE_AUTH_MAX_SKEW_SECONDS=300
SERVICE_AUTH_SECRET=
SERVICE_AUTH_REQUIRED=false
EVIDENCE_MAX_AGE_SECONDS=86400
EVIDENCE_MAX_ARTIFACT_BYTES=50000000
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=scrutineering

# ---------------------------------------------------------------------------
# Celery Beat Scheduler
# ---------------------------------------------------------------------------
# Cron expression for periodic scans (default: every 6 hours)
SCHEDULE_CRON_SCAN=0 */6 * * *
SCAN_RETENTION_DAYS=90
SCAN_PURGE_ENABLED=false
SCAN_COOLDOWN_SECONDS=3600
BACKUP_ROTATION_KEEP=7
BACKUP_MAX_AGE_DAYS=30
BACKUP_RESTORE_TARGET_ISOLATED=false
BACKUP_METADATA_PATH=
