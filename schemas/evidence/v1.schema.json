{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperclip.dev/schemas/evidence/v1.schema.json",
  "title": "Signed Supply-Chain Evidence Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "artifactType", "format", "subject", "artifactDigest", "generatedAt", "tool", "signature"],
  "properties": {
    "version": { "type": "string", "const": "1.0.0" },
    "artifactType": { "type": "string", "enum": ["sbom", "provenance"] },
    "format": { "type": "string", "enum": ["spdx-json", "cyclonedx-json", "slsa-provenance"] },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "maxLength": 512 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "artifactDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "identity", "value"],
      "properties": {
        "provider": { "type": "string", "enum": ["cosign", "sigstore", "kms"] },
        "identity": { "type": "string", "minLength": 1, "maxLength": 512 },
        "value": { "type": "string", "minLength": 16, "maxLength": 8192 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "artifactType": { "const": "sbom" } } },
      "then": { "properties": { "format": { "enum": ["spdx-json", "cyclonedx-json"] } } }
    },
    {
      "if": { "properties": { "artifactType": { "const": "provenance" } } },
      "then": { "properties": { "format": { "const": "slsa-provenance" } } }
    }
  ]
}
